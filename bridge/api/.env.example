# Copy to .env on the Pi and fill in values. Never commit real credentials.
PORT=3000
DEVICE_NAME=Campfire

# PulseAudio sink that drives the hardwired built-in speaker. Leave UNSET until
# the hardware exists — with it unset the bridge simply has no built-in output.
# Find the real name on the Pi with:  pactl list short sinks
# USB audio adapter example:  alsa_output.usb-Generic_USB_Audio-00.analog-stereo
# I2S DAC/amp HAT example:    alsa_output.platform-soc_sound.stereo-fallback
#BUILTIN_SINK_NAME=
